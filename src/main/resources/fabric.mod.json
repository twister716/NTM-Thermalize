{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}@golem.credits@",
    "authors": [
        "${mod_author}"
    ],
    "license": "${mod_license}",
    "icon": "assets/ntmthermalize/icon.png",
    "contact": {
        "homepage": "@golem.homepage@",
        "sources": "@golem.sources@",
        "issues": "@golem.issues@"
    },
    "environment": "*",
    "entrypoints": {
        "golemcore:entry": [
            "io.github.twister716.ntmthermalize.NTMThermalizeEntry"
        ],
        "client": [
            "io.github.twister716.ntmthermalize.platform.fabric.FabricClientInit"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "fabric-api": "*",
        "golemcore": ">=${golemcore_floor}",
        "hbm": ">=${hbm_floor}",
        "toughasnails": ">=${toughasnails_floor}",
        "minecraft": "${minecraft_range}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "ntmspace": ">=${ntmspace_floor}"
    }
}
